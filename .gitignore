# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# 环境与密钥（示例如 .env.example 入库，真实 .env 不入库）
.env

# 运行产物（索引由程序生成，不入库）
**/data/index.json
**/tests/_files/
**/.pytest_tmp/
*.db
*.log

# 前端
node_modules/
dist/
.DS_Store

# 构建/编译缓存与临时目录
.tmpbuild/
.npm-cache/
.piptmp/
**/*-tmp/

# 运行时缓存（jieba 词典缓存约 9MB，每次运行自动重建）
jieba.cache
*.cache

# 备份导出文件
backups/
*.dump
kb_db*.sql
