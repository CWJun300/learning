# 复制为 .env 后填入真实密码
# 说明：pydantic-settings 读取本文件，同名环境变量优先级更高

# ---------- 数据库 ----------
# 方案 A：MySQL（默认，功能完整，适合有多人访问）
DATABASE_URL=mysql+pymysql://kb_user:change_me@127.0.0.1:3306/kb_db?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://kb_user:change_me@127.0.0.1:3306/kb_test?charset=utf8mb4

# 方案 B：SQLite（服务器没装 MySQL 时用它，零依赖）
# 相对路径会按 fast_api 目录解析，与启动目录无关
# DATABASE_URL=sqlite:///./kb.db
# TEST_DATABASE_URL=sqlite:///./kb_test.db

# ---------- 服务监听 ----------
# 本机开发保持 127.0.0.1；部署到服务器改成 0.0.0.0 才能被外部访问
# （更安全的做法：仍绑 127.0.0.1，由 Nginx 反代对外）
HOST=127.0.0.1
PORT=8000
# 生产环境务必保持 false：reload 会 fork 子进程，且多进程会让内存索引各存一份
RELOAD=0

# ---------- 索引 ----------
# 相对路径按 fast_api 目录解析
INDEX_PATH=data/index.json

# ---------- 跨域 ----------
# 前后端同源部署（FastAPI 托管 dist）时不需要；开发期 vite 用 5173
# 部署后如果前端单独用域名访问，把真实域名加进来
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
